# NPChat configuration — copy to .env and edit. .env is gitignored.
#
# Embeddings always run in-process (sentence-transformers); only the LLM
# backend is switchable. Both backends use the OpenAI-compatible API, so the
# switch only changes the base URL and the model id.

# Which LLM backend to use: local | runpod
# - local  = llama.cpp server started by start_llm.ps1 (default)
# - runpod = vLLM OpenAI server on a RunPod pod
# Changing this requires an app restart (config is read once at import).
LLM_BACKEND=local

# ---- local (llama.cpp) ----------------------------------------------------- #
# Defaults match start_llm.ps1; override only if you change the alias/port.
# LOCAL_LLM_BASE_URL=http://localhost:8080/v1
# LOCAL_LLM_MODEL=qwen2.5-7b-instruct

# ---- runpod (vLLM) --------------------------------------------------------- #
# The model id is what vLLM ADVERTISES (its --served-model-name), NOT the HF
# repo path. Verify with:  curl <base_url>/models   and copy the "id" field.
# If the pod id changes, update RUNPOD_LLM_BASE_URL here — no code edit needed.
RUNPOD_LLM_BASE_URL=https://wetcua2lntx03a-8000.proxy.runpod.net/v1
RUNPOD_LLM_MODEL=qwen3-coder
